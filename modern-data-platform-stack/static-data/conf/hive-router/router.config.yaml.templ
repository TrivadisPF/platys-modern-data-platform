# GraphQL Hive Router configuration
# See https://the-guild.dev/graphql/hive/docs/router/configuration for all options.
#
# Most settings can also be provided via environment variables (set in the service
# definition). Values defined here take precedence for the keys they specify.

# HTTP server
# http:
#   host: 0.0.0.0
#   port: 4000

# Supergraph source (file is also provided via SUPERGRAPH_FILE_PATH)
# supergraph:
#   source: file
#   path: /app/supergraph.graphql

# Enable the in-browser GraphiQL-style laboratory
# laboratory:
#   enabled: true

# Logging
# log:
#   level: info
#   format: pretty-compact
